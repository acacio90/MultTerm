{
  "name": "multterm",
  "productName": "MultTerm",
  "version": "0.9.0",
  "private": true,
  "description": "Gerenciador de sessões SSH/RDP com terminal em abas",
  "author": "acacio90",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "multterm": "src/cli.ts"
  },
  "scripts": {
    "start": "npm run build && node scripts/electron.mjs .",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "multterm": "node src/cli.ts",
    "release": "node scripts/fetch-freerdp.mjs && npm run build && node scripts/release.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "icon": "node scripts/electron.mjs scripts/render-icon.mjs",
    "test:ui": "npm run build && playwright test",
    "test:ipsec": "node scripts/ipsec-gateway.mjs",
    "fetch:freerdp": "node scripts/fetch-freerdp.mjs"
  },
  "build": {
    "appId": "io.github.acacio90.multterm",
    "productName": "MultTerm",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "desktop/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/koffi/**",
      "dist/agent/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "${productName}-setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "acacio90",
        "repo": "MultTerm",
        "releaseType": "draft"
      }
    ],
    "extraResources": [
      {
        "from": "vendor/wintun",
        "to": "wintun",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "vendor/freerdp",
        "to": "freerdp",
        "filter": [
          "wfreerdp.exe",
          "LICENSE.txt"
        ]
      }
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.10",
    "koffi": "^3.3.3",
    "net-snmp": "^3.29.2",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/net-snmp": "^3.23.0",
    "@types/node": "^26.6.5",
    "@types/ssh2": "^1.15.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  }
}
